{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "oci-registry-proxy",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		/** Registry used for bare "/v2/..." requests. Also always allowed elsewhere. */
		"DEFAULT_REGISTRY": "docker.io",
		/** Allowlist for client-chosen registries: the common public registries,
		 *  so the open proxy cannot relay arbitrary private registries. */
		"ALLOWED_REGISTRIES": "docker.io,ghcr.io,quay.io,gcr.io,registry.k8s.io,k8s.m.daocloud.io",
		/** Mirror groups: JSON mapping registry name -> ordered member list.
		 *  Members are tried in order for tag lookups and raced for digest lookups. */
		"MIRROR_GROUPS": "{\"docker.io\":[\"docker.io\",\"docker.m.daocloud.io\",\"docker.1ms.run\"]}",
		/** Comma-separated hosts to contact over plain http (insecure; localhost is always http). */
		"INSECURE_REGISTRIES": "",
		/** "off" disables proxy authentication (local development only). */
		"PROXY_AUTH": "off",
		/** Seconds a tag-addressed manifest may be served from the edge cache. */
		"MANIFEST_TAG_TTL": "120",
		/** "false" disables the edge cache. */
		"BLOB_CACHE": "true"
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/v2",
			"/v2/*",
			"/-/auth",
			"/-/auth/*",
			"/api/*",
			"/*/v2",
			"/*/v2/*"
		]
	}
	/**
	 * Secrets:
	 *   PROXY_TOKEN    — shared client token for `docker login` (required unless PROXY_AUTH=off)
	 *   REGISTRY_AUTHS — optional JSON map of per-member upstream credentials, e.g.
	 *                    {"ghcr.io": "user:pat", "registry.example.com:5000": "user:pass"}
	 *   Set with: npx wrangler secret put PROXY_TOKEN
	 */
}
